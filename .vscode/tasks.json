{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Vite dev server",
      "type": "shell",
      "command": "npm run dev -- --port 5173 --strictPort",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "http://localhost:5173/"
        }
      }
    },
    {
      "label": "Run tests",
      "type": "npm",
      "script": "test",
      "group": "test"
    },
    {
      "label": "Build",
      "type": "npm",
      "script": "build",
      "group": "build"
    }
  ]
}
